# API Ports
BACKEND_PORT=7000
UPLOAD_PORT=7002

# PostgreSQL
PG_HOST_DB=localhost
PG_PORT_DB=5432
PG_USERNAME_DB=postgres
PG_PASSWORD_DB=postgres
PG_DATABASE=mcq_extractor

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=admin

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here

# Storage Directories
BASE_SAVE_DIR=temp
UPLOAD_DIR=uploads
